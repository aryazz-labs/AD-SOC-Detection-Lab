index=windows_security (sourcetype="WinEventLog:Security" OR sourcetype="XmlWinEventLog:Security")
| rex field=_raw "<EventID[^>]*>(?<xml_eid>\d+)</EventID>"
| eval EID=coalesce(xml_eid, EventCode)
| where EID="4720"
| rex field=_raw "<Data Name='TargetUserName'>(?<x_target>[^<]+)"
| rex field=_raw "<Data Name='SubjectUserName'>(?<x_actor>[^<]+)"
| rex field=_raw "(?s)New Account:\s+Security ID:[^\r\n]*[\r\n]+\s+Account Name:\s+(?<c_target>[^\r\n]+)"
| rex field=_raw "(?s)Subject:\s+Security ID:[^\r\n]*[\r\n]+\s+Account Name:\s+(?<c_actor>[^\r\n]+)"
| eval CreatedAccount=trim(coalesce(x_target,c_target)), CreatedBy=trim(coalesce(x_actor,c_actor))
| eval Scope=if(sourcetype="XmlWinEventLog:Security","Domain account (DC)","Local account (workstation)")
| eval Detection="New Account Created", MITRE="T1136", Severity="Medium"
| table _time host Scope Detection Severity MITRE CreatedBy CreatedAccount EID
| sort -_time
